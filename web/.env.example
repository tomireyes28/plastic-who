# Conexión directa desde Next.js Server Components a Supabase (para Vercel / desarrollo local sin Railway)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Opcional: URL del backend NestJS si se desea consumir vía API REST externa
# NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Fuente por defecto: live. Usar demo solo para mostrar ejemplos etiquetados.
CATALOG_MODE=live
# Alternativa de servidor cuando no se usa DATABASE_URL. Incluye el prefijo /api.
# CATALOG_API_URL="http://localhost:3001/api"
