{
  "name": "plastic-who",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Plastic Who? (API NestJS + Web Next.js + Shared Types)",
  "workspaces": [
    "api",
    "web",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=plastic-who-api",
    "dev:web": "npm run dev --workspace=plastic-who-web",
    "build:api": "npm run build --workspace=plastic-who-api",
    "build:web": "npm run build --workspace=plastic-who-web",
    "test:api": "npm run test --workspace=plastic-who-api",
    "db:generate": "npm run prisma:generate --workspace=plastic-who-api",
    "db:push": "npm run prisma:push --workspace=plastic-who-api",
    "db:migrate": "npm run prisma:migrate --workspace=plastic-who-api",
    "db:studio": "npm run prisma:studio --workspace=plastic-who-api",
    "scrape:wanama": "npm run scrape:wanama --workspace=plastic-who-api",
    "scrape:all": "npm run scrape:all --workspace=plastic-who-api"
  }
}
